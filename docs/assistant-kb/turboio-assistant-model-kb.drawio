olor=#d79b00;dashed=1;" edge="1" parent="1" source="F1" target="C1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="1065"/><mxPoint x="2005" y="1065"/><mxPoint x="2005" y="230"/><mxPoint x="950" y="230"/></Array></mxGeometry></mxCell><mxCell id="e17" value="第 2 页" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="A1" target="A1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="F2" target="A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="最终回答" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="C3" target="F2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="958"/></Array></mxGeometry></mxCell></root></diagram><diagram id="有问必答链路" name="有问必答链路"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="G1" value="① 厂商主动提示 hint 对象&amp;lt;br&amp;gt;字段 text：JSON{question,answer} 或纯文本" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="280" height="64" as="geometry"/></mxCell><mxCell id="G2" value="② TurboAddon.dispatchProactiveHint&amp;lt;br&amp;gt;读 McpConnectionStore 快照&amp;lt;br&amp;gt;+ endpoint / model / 模型 Key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="300" height="88" as="geometry"/></mxCell><mxCell id="G3" value="③ ProactiveHintAugmentor.interceptAndRegenerateAsync&amp;lt;br&amp;gt;反射读取 text 字段&amp;lt;br&amp;gt;校验 generation / sequence / revision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="340" height="88" as="geometry"/></mxCell><mxCell id="G4" value="④ 闸门：enabled / endpoint 非空 / question 非空&amp;lt;br&amp;gt;缓存命中（revision+question）→ 复用上次答案" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="222" width="340" height="76" as="geometry"/></mxCell><mxCell id="G5" value="⑤ 看门狗 18s 启动&amp;lt;br&amp;gt;检索预算 = min(15000ms, 剩余时间)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="322" width="340" height="60" as="geometry"/></mxCell><mxCell id="H1" value="⑥ KnowledgeRetrieval.retrieve" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="322" width="300" height="60" as="geometry"/></mxCell><mxCell id="H2" value="CortrixClient（MCP over HTTP）&amp;lt;br&amp;gt;initialize → tools/list → tools/call&amp;lt;br&amp;gt;会话复用；404 / IO 失效 → 冷握手重试" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="406" width="300" height="88" as="geometry"/></mxCell><mxCell id="H3" value="cortrix_query（rerank=false）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="518" width="300" height="56" as="geometry"/></mxCell><mxCell id="H4" value="Evidence：doc_id / source_path&amp;lt;br&amp;gt;/ score / text / 覆盖元数据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="598" width="300" height="60" as="geometry"/></mxCell><mxCell id="I1" value="⑦ Result 判定&amp;lt;br&amp;gt;HIT / NO_MATCH / AUTH_ERROR /&amp;lt;br&amp;gt;TIMEOUT / TRANSPORT_ERROR（revision 一致）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="322" width="340" height="88" as="geometry"/></mxCell><mxCell id="I2" value="无 API Key → synthesize()&amp;lt;br&amp;gt;拼装【知识库证据】+ 覆盖元数据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="444" width="162" height="100" as="geometry"/></mxCell><mxCell id="I3" value="有 API Key → LLM 重写&amp;lt;br&amp;gt;POST /chat/completions（≤2200ms）&amp;lt;br&amp;gt;裁剪 120 字 + 控制字符清洗" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1718" y="444" width="162" height="100" as="geometry"/></mxCell><mxCell id="J1" value="⑧ Pending.accept：校验原文未被改写&amp;lt;br&amp;gt;field.set(hint, replaceAnswer(...))" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="340" height="76" as="geometry"/></mxCell><mxCell id="J2" value="delivery.deliver → invoke onProactiveHint&amp;lt;br&amp;gt;→ 眼镜显示与朗读" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="606" width="340" height="64" as="geometry"/></mxCell><mxCell id="J3" value="失败 / 降级 → 放行云端原回答&amp;lt;br&amp;gt;diagnostic / chatLog 记录原因" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="606" width="280" height="64" as="geometry"/></mxCell><mxCell id="K1" value="放行与预算：看门狗 18s ｜ 检索 ≤15s ｜ 模型重写 ≤2.2s。任何一步失败（未启用 / 未配置 / 空问题 / 超时 / 协议错误 / 无证据 / 模型不可用 / 提示已被改写）都不阻塞提示：直接放行厂商云端原回答，并在 diagnostic 与 chatLog 记录原因。只有 HIT、证据非空、revision 一致且在预算内时，才改写 hint.text 并回传。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="742" width="1820" height="96" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="G1" target="G2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="G2" target="G3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="G3" target="G4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="G4" target="G5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5" value="检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="G5" target="H1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H1" target="H2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H2" target="H3"><mxGeometry relative="1" as="geometry"></m