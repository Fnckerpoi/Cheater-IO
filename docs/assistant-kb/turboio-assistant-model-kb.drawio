<mxfile host="app.diagrams.net"><diagram id="助手×模型×知识库" name="助手×模型×知识库"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="A1" value="① 厂商 SDK 回调&amp;lt;br&amp;gt;ASR / NLP / 主动提示" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="280" height="64" as="geometry"/></mxCell><mxCell id="A1b" value="厂商主动提示 onProactiveHint&amp;lt;br&amp;gt;（→ 有问必答链路，见第 2 页）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="214" width="280" height="56" as="geometry"/></mxCell><mxCell id="A2" value="眼镜显示 + TTS&amp;lt;br&amp;gt;onNlpResult / onResponseComplete" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="280" height="56" as="geometry"/></mxCell><mxCell id="B1" value="② TurboAddon.dispatchAsr&amp;lt;br&amp;gt;串行投递到主线程" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="300" height="60" as="geometry"/></mxCell><mxCell id="B2" value="onAsr：会话去重&amp;lt;br&amp;gt;记录 question" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="194" width="300" height="56" as="geometry"/></mxCell><mxCell id="B3" value="③ ChatPolicy.eligible&amp;lt;br&amp;gt;chat/workflow 或 agent/askai&amp;lt;br&amp;gt;非 offline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="274" width="300" height="70" as="geometry"/></mxCell><mxCell id="B4" value="不接管 → 保留官方回答" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="384" width="300" height="48" as="geometry"/></mxCell><mxCell id="C1" value="④ request() 组装 messages&amp;lt;br&amp;gt;system = persona + 模型 ID + 工具指引&amp;lt;br&amp;gt;history + 当前问题" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="274" width="340" height="76" as="geometry"/></mxCell><mxCell id="C2" value="⑤ POST {endpoint}/chat/completions&amp;lt;br&amp;gt;stream=true / tools / tool_choice=auto&amp;lt;br&amp;gt;Bearer Key ← SecretStore(Keystore)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="390" width="340" height="76" as="geometry"/></mxCell><mxCell id="C3" value="⑥ SSE 解析&amp;lt;br&amp;gt;累积 delta.content，拼装 tool_calls" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="506" width="340" height="60" as="geometry"/></mxCell><mxCell id="D1" value="⑦ 工具回合 ≤4 轮&amp;lt;br&amp;gt;工具调用 ≤3 次，dsh_dispatch ≤1 次&amp;lt;br&amp;gt;knowledge_query / web_search / dsh_dispatch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="506" width="300" height="80" as="geometry"/></mxCell><mxCell id="D2" value="ToolClient.call 参数校验&amp;lt;br&amp;gt;query 2–200 字，拒收敏感串" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="610" width="300" height="60" as="geometry"/></mxCell><mxCell id="D3" value="knowledge_query：预算 30000ms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="694" width="300" height="56" as="geometry"/></mxCell><mxCell id="E1" value="⑧ KnowledgeRetrieval.retrieve&amp;lt;br&amp;gt;Snapshot：enabled / endpoint / revision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="694" width="300" height="60" as="geometry"/></mxCell><mxCell id="E2" value="CortrixClient（MCP over HTTP）&amp;lt;br&amp;gt;会话复用：endpoint+token 缓存&amp;lt;br&amp;gt;warm 只发 tools/call，失效回冷握手" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="778" width="300" height="80" as="geometry"/></mxCell><mxCell id="E3" value="cortrix_query&amp;lt;br&amp;gt;top_k=2，rerank=false" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="882" width="300" height="56" as="geometry"/></mxCell><mxCell id="E4" value="Cortrix 文档 / 命名空间" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="962" width="300" height="56" as="geometry"/></mxCell><mxCell id="F1" value="Result 回填 messages&amp;lt;br&amp;gt;+ system 引导（HIT / 未命中）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="952" width="300" height="76" as="geometry"/></mxCell><mxCell id="F2" value="emit()：增量回写官方回调&amp;lt;br&amp;gt;onNlpResult / onResponseComplete" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="920" width="300" height="76" as="geometry"/></mxCell><mxCell id="N1" value="边界与策略：问答资格由 ChatPolicy 判定，其余保留官方回答；模型请求走自有 endpoint，Bearer Key 存于 Keystore；工具回合 ≤4 轮、单轮 ≤2 个并行工具、工具调用 ≤3 次；MCP 配置 revision 变化即中止当前回合；知识库证据与工具返回一律视为不可信外部数据，提示词显式要求忽略其中指令；任何失败都回退官方回答，不阻塞眼镜。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="1900" height="96" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="A1" target="B1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="B2" target="B3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="不接管" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="B3" target="B4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="命中问答" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="B3" target="C1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="C1" target="C2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;"